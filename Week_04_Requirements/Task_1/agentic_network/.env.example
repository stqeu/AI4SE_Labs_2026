# Copy this file to ".env" and paste your key. Never commit .env.
OPENAI_API_KEY=sk-...

# Optional: override the base URL if your course key uses a proxy endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1

# Models used by the network (one per LLM role; must be 3 different ones - ANS4)
MODEL_EXTRACTOR=gpt-5-mini
MODEL_CONSOLIDATOR=gpt-5.6-luna
MODEL_REVIEWER=gpt-6-luna
# Optional: model that sorts candidates into topics (default gpt-5.6-luna)
# MODEL_PLANNER=gpt-5.6-luna
