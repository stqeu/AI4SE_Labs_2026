    "code": "def price(self, items: Sequence[LineItem]) -> Money:\n    \"\"\"Return the base price, less the discount if the quantity qualifies.\"\"\"\n    total_qty = sum(item.quantity for item in items)\n    base_total = self._base.price(items)\n    if total_qty >= self._threshold:\n        # apply percent off to the total\n        return (base_total * (100 - self._percent_off)) // 100\n    return base_total"
  },
